{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "scenarioId",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/native-pilot-v1",
      "type": "string"
    },
    "kind": {
      "const": "NativePilotScenario",
      "type": "string"
    },
    "scenarioId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "steps": {
      "minItems": 2,
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "tap",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "text"
            ],
            "properties": {
              "action": {
                "const": "input-text",
                "type": "string"
              },
              "text": {
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^(?![\\s\\S]*\\$\\{)[^\\r\\n]+$",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "characters"
            ],
            "properties": {
              "action": {
                "const": "erase-text",
                "type": "string"
              },
              "characters": {
                "minimum": 1,
                "maximum": 512,
                "type": "integer"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "direction"
            ],
            "properties": {
              "action": {
                "const": "swipe",
                "type": "string"
              },
              "direction": {
                "anyOf": [
                  {
                    "const": "UP",
                    "type": "string"
                  },
                  {
                    "const": "DOWN",
                    "type": "string"
                  },
                  {
                    "const": "LEFT",
                    "type": "string"
                  },
                  {
                    "const": "RIGHT",
                    "type": "string"
                  }
                ]
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "start",
              "end",
              "durationMs"
            ],
            "properties": {
              "action": {
                "const": "drag",
                "type": "string"
              },
              "start": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "minimum": 0,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "y": {
                    "minimum": 0,
                    "maximum": 100,
                    "type": "integer"
                  }
                }
              },
              "end": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "minimum": 0,
                    "maximum": 100,
                    "type": "integer"
                  },
                  "y": {
                    "minimum": 0,
                    "maximum": 100,
                    "type": "integer"
                  }
                }
              },
              "durationMs": {
                "minimum": 400,
                "maximum": 2000,
                "type": "integer"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "assert-visible",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "assert-hidden",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "checkpointId"
            ],
            "properties": {
              "action": {
                "const": "screenshot",
                "type": "string"
              },
              "checkpointId": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
