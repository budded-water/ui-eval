{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "scenarioId",
    "steps"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/native-pilot-v1",
      "type": "string"
    },
    "kind": {
      "const": "NativePilotScenario",
      "type": "string"
    },
    "scenarioId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "steps": {
      "minItems": 2,
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "tap",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "assert-visible",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "selector"
            ],
            "properties": {
              "action": {
                "const": "assert-hidden",
                "type": "string"
              },
              "selector": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^(?!.*\\$\\{)[^\\r\\n]+$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "action",
              "checkpointId"
            ],
            "properties": {
              "action": {
                "const": "screenshot",
                "type": "string"
              },
              "checkpointId": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$",
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
