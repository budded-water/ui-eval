      "required": [
        "plan",
        "evidence",
        "assessment"
      ],
      "properties": {
        "plan": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "apiVersion",
            "kind",
            "id",
            "projectId",
            "outcome",
            "plannedAt",
            "planningContext",
            "requirements",
            "omissions"
          ],
