                    "properties": {
                      "kind": {
                        "anyOf": [
                          {
                            "const": "check",
                            "type": "string"
                          },
                          {
                            "const": "scenario",
                            "type": "string"
                          },
                          {
                            "const": "external",
                            "type": "string"
                          }
                        ]
                      },
                      "id": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
                        "type": "string"
                      }
                    }
                  },
                  "visualReview": {
                    "type": "boolean"
