                "required": [
                  "id",
                  "category",
                  "rationale",
                  "expectedOutcome",
                  "level",
                  "environment",
                  "selector",
                  "visualReview"
                ],
                "properties": {
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
                    "type": "string"
                  },
                  "category": {
                    "anyOf": [
                      {
                        "const": "code",
                        "type": "string"
                      },
                      {
                        "const": "ui",
                        "type": "string"
                      },
                      {
                        "const": "release",
                        "type": "string"
                      }
                    ]
                  },
                  "rationale": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  },
                  "expectedOutcome": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  },
                  "level": {
                    "anyOf": [
                      {
                        "const": "L1",
                        "type": "string"
                      },
                      {
                        "const": "L2",
                        "type": "string"
                      },
                      {
                        "const": "L3",
                        "type": "string"
                      },
                      {
                        "const": "L4",
                        "type": "string"
                      },
                      {
                        "const": "L5",
                        "type": "string"
                      }
                    ]
                  },
                  "environment": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "platform"
                    ],
                    "properties": {
                      "platform": {
                        "anyOf": [
                          {
                            "const": "host",
                            "type": "string"
                          },
                          {
                            "const": "web",
                            "type": "string"
                          },
                          {
                            "const": "ios-simulator",
                            "type": "string"
                          },
                          {
                            "const": "wechat-devtools",
                            "type": "string"
                          },
                          {
                            "const": "physical-device",
                            "type": "string"
                          }
                        ]
