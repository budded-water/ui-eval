                    "type": "string"
                  },
                  "deviceId": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  },
                  "variantKey": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  }
                }
              },
              "selector": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "anyOf": [
                      {
                        "const": "check",
                        "type": "string"
                      },
                      {
                        "const": "scenario",
                        "type": "string"
                      },
                      {
                        "const": "external",
                        "type": "string"
                      }
                    ]
                  },
                  "id": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
