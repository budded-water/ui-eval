                    "const": "L2",
                    "type": "string"
                  },
                  {
                    "const": "L3",
                    "type": "string"
                  },
                  {
                    "const": "L4",
                    "type": "string"
                  },
                  {
                    "const": "L5",
                    "type": "string"
