                      },
                      {
                        "const": "web",
                        "type": "string"
                      },
                      {
                        "const": "ios-simulator",
                        "type": "string"
                      },
                      {
                        "const": "wechat-devtools",
                        "type": "string"
                      },
                      {
                        "const": "physical-device",
