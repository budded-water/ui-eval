                }
              }
            },
            "omissions": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "scope",
                  "reason"
                ],
                "properties": {
                  "scope": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  },
                  "reason": {
                    "minLength": 1,
                    "maxLength": 2048,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
