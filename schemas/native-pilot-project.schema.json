{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "platform",
    "appId",
    "maestroVersion",
    "timeoutMs",
    "scenarios"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/native-pilot-v1",
      "type": "string"
    },
    "kind": {
      "const": "NativePilotProject",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "platform": {
      "const": "ios-simulator",
      "type": "string"
    },
    "appId": {
      "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$",
      "type": "string"
    },
    "maestroVersion": {
      "const": "2.9.0",
      "type": "string"
    },
    "timeoutMs": {
      "minimum": 1000,
      "maximum": 600000,
      "type": "integer"
    },
    "scenarios": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "pattern": "^[a-zA-Z0-9/_-]+\\.json$",
          "type": "string"
        }
      }
    }
  }
}
