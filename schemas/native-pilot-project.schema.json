{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "platform",
    "appId",
    "maestroVersion",
    "timeoutMs",
    "scenarios"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/native-pilot-v1",
      "type": "string"
    },
    "kind": {
      "const": "NativePilotProject",
      "type": "string"
    },
    "projectId": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "platform": {
      "const": "ios-simulator",
      "type": "string"
    },
    "appId": {
      "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$",
      "type": "string"
    },
    "maestroVersion": {
      "const": "2.9.0",
      "type": "string"
    },
    "restartApp": {
      "type": "boolean"
    },
    "minimumFreeBytes": {
      "minimum": 67108864,
      "maximum": 68719476736,
      "type": "integer"
    },
    "reviews": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "scenarioId",
          "checkpointId",
          "criterion"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "scenarioId": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "checkpointId": {
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "criterion": {
            "minLength": 1,
            "maxLength": 1000,
            "type": "string"
          },
          "screenshotMethod": {
            "anyOf": [
              {
                "const": "maestro-take-screenshot",
                "type": "string"
              },
              {
                "const": "simctl",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "timeoutMs": {
      "minimum": 1000,
      "maximum": 600000,
      "type": "integer"
    },
    "scenarios": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "pattern": "^[a-zA-Z0-9/_-]+\\.json$",
          "type": "string"
        }
      }
    }
  }
}
