{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "repository",
    "revision"
  ],
  "properties": {
    "repository": {
      "pattern": "^https://[^/@?#]+/[^?#]+$",
      "maxLength": 512,
      "type": "string"
    },
    "revision": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
    },
    "bunVersion": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    }
  }
}
