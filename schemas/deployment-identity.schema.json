{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "uieval.deployment/v1alpha1",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "apiContractVersion": {
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "featureFlagsDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "dataRevision": {
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
    }
  }
}
