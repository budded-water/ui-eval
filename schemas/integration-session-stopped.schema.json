{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "sessionId",
    "status"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/integration-session-v1",
      "type": "string"
    },
    "kind": {
      "const": "stopped",
      "type": "string"
    },
    "sessionId": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "pass",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "type": "string"
        }
      ]
    }
  }
}
