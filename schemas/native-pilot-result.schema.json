{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "experimental",
    "projectId",
    "scenarioId",
    "executionId",
    "status",
    "reason",
    "planDigest",
    "sourceDigest",
    "sourceCommit",
    "device",
    "appId",
    "provenanceAssurance",
    "assertions",
    "screenshots",
    "limitations"
  ],
  "properties": {
    "apiVersion": {
      "const": "uieval.io/native-pilot-v1",
      "type": "string"
    },
    "kind": {
      "const": "NativePilotResult",
      "type": "string"
    },
    "experimental": {
      "const": true,
      "type": "boolean"
    },
    "projectId": {
      "type": "string"
    },
    "scenarioId": {
      "type": "string"
    },
    "executionId": {
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "inconclusive",
          "type": "string"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "planDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "sourceDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "sourceCommit": {
      "type": "string"
    },
    "device": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "runtime",
        "maestroVersion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "maestroVersion": {
          "type": "string"
        }
      }
    },
    "appId": {
      "type": "string"
    },
    "provenanceAssurance": {
      "const": "observed-source-and-installed-app-only",
      "type": "string"
    },
    "screenshotMethod": {
      "const": "maestro-take-screenshot",
      "type": "string"
    },
    "assertions": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "passed",
        "failed"
      ],
      "properties": {
        "passed": {
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checkpointId",
          "path",
          "digest",
          "widthPx",
          "heightPx"
        ],
        "properties": {
          "checkpointId": {
            "type": "string"
          },
          "path": {
            "pattern": "^[a-z][a-z0-9-]*\\.png$",
            "type": "string"
          },
          "digest": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "widthPx": {
            "minimum": 1,
            "type": "integer"
          },
          "heightPx": {
            "minimum": 1,
            "type": "integer"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "method",
        "failedStep",
        "imageComparison",
        "targetBoundsBasis",
        "cause",
        "nextAction"
      ],
      "properties": {
        "method": {
          "const": "existing-driver-artifacts",
          "type": "string"
        },
        "failedStep": {
          "minimum": 0,
          "type": "integer"
        },
        "precedingInteraction": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "step",
            "action"
          ],
          "properties": {
            "step": {
              "minimum": 0,
              "type": "integer"
            },
            "action": {
              "anyOf": [
                {
                  "const": "tap",
                  "type": "string"
                },
                {
                  "const": "swipe",
                  "type": "string"
                },
                {
                  "const": "drag",
                  "type": "string"
                },
                {
                  "const": "input-text",
                  "type": "string"
                },
                {
                  "const": "erase-text",
                  "type": "string"
                }
              ]
            }
          }
        },
        "before": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "path",
            "digest",
            "widthPx",
            "heightPx"
          ],
          "properties": {
            "path": {
              "pattern": "^driver/(?:[A-Za-z0-9][A-Za-z0-9_-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "widthPx": {
              "minimum": 1,
              "type": "integer"
            },
            "heightPx": {
              "minimum": 1,
              "type": "integer"
            }
          }
        },
        "after": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "path",
            "digest",
            "widthPx",
            "heightPx"
          ],
          "properties": {
            "path": {
              "pattern": "^driver/(?:[A-Za-z0-9][A-Za-z0-9_-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "widthPx": {
              "minimum": 1,
              "type": "integer"
            },
            "heightPx": {
              "minimum": 1,
              "type": "integer"
            }
          }
        },
        "hierarchy": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "path",
            "digest"
          ],
          "properties": {
            "path": {
              "pattern": "^driver/(?:[A-Za-z0-9][A-Za-z0-9_-]*/)*[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            "digest": {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          }
        },
        "imageComparison": {
          "anyOf": [
            {
              "const": "identical-pixels",
              "type": "string"
            },
            {
              "const": "different-pixels",
              "type": "string"
            },
            {
              "const": "unavailable",
              "type": "string"
            }
          ]
        },
        "targetBounds": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            },
            "height": {
              "minimum": 1,
              "type": "integer"
            }
          }
        },
        "targetBoundsBasis": {
          "const": "unique-exact-selector-in-post-failure-hierarchy-only",
          "type": "string"
        },
        "cause": {
          "const": "undetermined",
          "type": "string"
        },
        "nextAction": {
          "const": "Inspect the selected App state, overlays and input delivery; a completed command does not prove the intended UI changed.",
          "type": "string"
        }
      }
    },
    "driverTiming": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "wallElapsedMs",
        "monotonicElapsedMs",
        "timeoutMs"
      ],
      "properties": {
        "wallElapsedMs": {
          "type": "number"
        },
        "monotonicElapsedMs": {
          "minimum": 0,
          "type": "number"
        },
        "timeoutMs": {
          "minimum": 1,
          "type": "integer"
        }
      }
    }
  }
}
